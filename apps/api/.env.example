PORT=4000
# Origines autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:3001
# Chaîne de connexion PostgreSQL (Neon)
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE/neondb?sslmode=verify-full
# Clé pour consulter les demandes : GET /api/admin/requests avec l'en-tête x-admin-key
ADMIN_KEY=changez-moi
